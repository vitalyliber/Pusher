<div class="bg-white shadow-lg rounded-lg p-6 text-center">
  <h2 class="text-md font-semibold text-gray-700">
    <%= title %>
  </h2>
  <p class="text-xl mt-2 text-gray-400">
    <span class="text-blue-600 font-bold">
      <%= number_with_delimiter(firebase_count + huawei_count) %>
    </span>
    (
    <span class="text-yellow-400 mt-1" title="Firebase">
      <%= number_with_delimiter(firebase_count) %>
    </span>
    /
    <span class="text-red-400 mt-1" title="Huawei">
      <%= number_with_delimiter(huawei_count) %>
    </span>
    )
  </p>
</div>
