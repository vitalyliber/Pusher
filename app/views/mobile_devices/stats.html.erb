<turbo-frame id="stats">
  <%= link_to mobile_accesses_path do %>
    <div class="container mx-auto p-4 mb-10">
      <h1 class="text-xl font-bold text-center mb-6">User Activity Statistics</h1>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Daily -->
        <%= render partial: 'stats_tile', locals: { title: 'Last Day', firebase_count: @daily_firebase_count, huawei_count: @daily_huawei_count } %>
        <!-- Weekly -->
        <%= render partial: 'stats_tile', locals: { title: 'Last Week', firebase_count: @weekly_firebase_count, huawei_count: @weekly_huawei_count } %>
        <!-- Monthly -->
        <%= render partial: 'stats_tile', locals: { title: 'Last Month', firebase_count: @monthly_firebase_count, huawei_count: @monthly_huawei_count } %>
      </div>
    </div>
  <% end %>
</turbo-frame>
